+//> Origin that serves saved frames, stamped into the page by the server. Anything
+//  that is not an absolute http(s) origin -- unset, or an unsubstituted
+//  placeholder -- means "this page's own origin", the historical behavior.
+const ARTIFACT_ORIGIN = (() => {
+    const meta = document.querySelector('meta[name="codeframe-artifact-origin"]');
+    const configured = meta === null ? '' : meta.content.trim();
+    return /^https?:\/\//.test(configured) ? configured : window.location.origin;
+})();
