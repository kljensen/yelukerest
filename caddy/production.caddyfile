# Default production profile: AWS Route 53 supplies ACME DNS challenges.
# Course-independent host routing lives in production-sites.caddyfile.
(dns_tls) {
	tls {
		dns route53 {
			# The plug-in reads AWS_REGION, AWS_ACCESS_KEY_ID, and
			# AWS_SECRET_ACCESS_KEY from the Caddy container environment.
			# https://github.com/libdns/route53
			wait_for_propagation true
		}
	}
}

import production-sites.caddyfile
