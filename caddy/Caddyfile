{
	debug
}
:80 {
	log {
	}
	# Redirect to https
	redir https://{host}{uri} permanent
}

(elmclient) {
	root * /var/elmclient
	file_server
}

(security_headers) {
	header {
		?X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		X-Frame-Options "DENY"
	}
	header /auth/* {
		Cache-Control "no-store"
		Pragma "no-cache"
		Expires "0"
	}
	header /rest/* {
		-Access-Control-Allow-Origin
		-Access-Control-Allow-Credentials
		-Access-Control-Allow-Headers
		-Access-Control-Allow-Methods
		-Access-Control-Expose-Headers
		-Access-Control-Max-Age
	}
}

(app_csp) {
	# The OAuth consent page is excluded because authapp sets its own,
	# narrower CSP there -- one that must widen form-action to the client's
	# registered redirect origin, since Safari enforces form-action against
	# every hop of a redirect chain. Two CSP headers are enforced as their
	# INTERSECTION, so leaving this one applied would re-impose 'self' and
	# break consent no matter what authapp sends.
	@not_openapi {
		not path /openapi*
		not path /auth/oauth/*
	}
	header @not_openapi Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'"
}

(swagger_csp) {
	header /openapi* Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'"
}

(postgrest) {
	# Pass /rest/ to Postgrest docker container.
	# Use the $POSTGREST_PORT environment variable to set the port.
	# Limit request body size as belt-and-suspenders alongside the
	# database CHECK constraints. The largest legitimate API writes
	# (assignment sync payloads) stay well under this; artifact files
	# are stored outside this path, so only their metadata rows come
	# through here.
	route /rest/* {
		uri strip_prefix /rest
		# The faculty sync RPCs legitimately carry multi-megabyte JSON
		# payloads; the functions themselves enforce 4/8 MB caps, so the
		# proxy allows slightly more. Everything else stays at 1 MB.
		@sync path /rpc/sync_assignments /rpc/sync_meetings
		handle @sync {
			request_body {
				max_size 10MB
			}
			reverse_proxy postgrest:{$POSTGREST_PORT}
		}
		handle {
			request_body {
				max_size 1MB
			}
			reverse_proxy postgrest:{$POSTGREST_PORT}
		}
	}
}

(authapp) {
	# Pass /auth/ to AuthApp docker container.
	# Use the $AUTHAPP_PORT environment variable to set the port.
	# Auth requests carry no large bodies, so cap them tightly.
	route /auth/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy authapp:{$AUTHAPP_PORT}
	}
	route /cas/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy authapp:{$AUTHAPP_PORT}
	}
}

(mcpapp) {
	# Pass the MCP endpoint and its RFC 9728 protected resource metadata
	# to the mcpapp docker container.
	# Use the $MCPAPP_PORT environment variable to set the port.
	# MCP messages are JSON-RPC bodies; cap them tightly. mcpapp also
	# enforces its own per-request body limit and rate limits.
	route /mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy mcpapp:{$MCPAPP_PORT}
	}
	route /.well-known/oauth-protected-resource* {
		request_body {
			max_size 1MB
		}
		reverse_proxy mcpapp:{$MCPAPP_PORT}
	}
}

(hydra) {
	# Pass Ory Hydra's PUBLIC OAuth/OIDC endpoints to the hydra docker
	# container (issue #270). The issuer is the domain root, so these
	# specific paths are routed at the top level; see hydra/hydra.yml
	# for the rationale. Only the public API (port $HYDRA_PUBLIC_PORT,
	# 4444) is ever routed here — the admin API (port 4445) must NEVER
	# be proxied. OAuth requests are small (auth redirects, token and
	# DCR JSON bodies), so cap bodies tightly.
	# Dynamic Client Registration goes through authapp, NOT directly to
	# Hydra: Hydra's DCR responses include null/empty optional fields
	# that strict-parser MCP clients reject (ory/hydra#4044, fix PR
	# #4050 unmerged). authapp reverse-proxies these paths to Hydra's
	# public port, cleans the response JSON, injects the MCP audience
	# allowlist, and hardens registration (per-IP rate limit,
	# redirect_uri validation). Route these directly to Hydra again
	# once the upstream fix ships (issue #272).
	@hydra_dcr {
		path /oauth2/register /oauth2/register/*
	}
	route @hydra_dcr {
		request_body {
			max_size 64KB
		}
		reverse_proxy authapp:{$AUTHAPP_PORT}
	}
	@hydra_public {
		path /oauth2/auth /oauth2/auth/* /oauth2/token /oauth2/revoke /oauth2/sessions/* /oauth2/fallbacks/* /userinfo /.well-known/openid-configuration /.well-known/oauth-authorization-server /.well-known/jwks.json
	}
	route @hydra_public {
		request_body {
			max_size 64KB
		}
		reverse_proxy hydra:{$HYDRA_PUBLIC_PORT}
	}
}

# Codeframe, split across two hostnames so that student-authored JavaScript
# never shares an origin with a session cookie (issue #359). Codeframe serves
# an editor that publishes AND the pages people publish with it; on one origin,
# a page a student wrote could `fetch('/api/frame/', {method:'POST'})` and
# publish as any signed-in visitor, because the cookie rides along same-origin.
#
#   code.<domain>     Public artifacts only: GET /f/<html>/<js>.html. No
#                     session cookie is ever set on this host.
#   editor.<domain>   The authenticated editor and the write API. The CAS
#                     session cookie is host-only to this name.
#
# Both are a SINGLE label under the naked domain on purpose: Yale CAS accepts
# *.656.mba and a conventional wildcard matches one label only (issue #364), so
# editor.code.<domain> would fall outside it and need hand registration.
(codeframe_artifacts) {
	# Anchored at .html so the artifact path and the editor entry point that
	# differs from it only by suffix -- /f/<h>/<j>.html/edit -- cannot be
	# confused for one another. The artifact is matched first, below.
	@artifact {
		method GET HEAD
		path_regexp ^/f/[^/]+/[^/]+\.html$
	}

	# The assignment prose already published to students recommends this host,
	# and past submissions and handouts link to it, so the editor entry points
	# redirect here rather than 404. A redirect sets no cookie and executes no
	# script, so this host still never carries a session.
	@editor_entry path_regexp ^(/|/new|/welcome|/h/[^/]+/j/[^/]+/edit|/f/[^/]+/[^/]+\.html/edit)$

	# One route block so the order below is the literal file order rather than
	# Caddy's directive ordering: the artifact match must be tried first.
	route {
		handle @artifact {
			reverse_proxy codeframe:{$CODEFRAME_PORT} {
				# Nothing upstream sets a cookie today, and nothing on this
				# host ever may. Strip it rather than trust that.
				header_down -Set-Cookie
			}
		}
		handle @editor_entry {
			redir https://editor.{$NAKED_FQDN}{uri} 302
		}
		# The one asset a published page needs. Rendered artifacts reference
		# torus-dom, vendored into the image rather than pulled from unpkg at
		# request time (issue #362), so it has to be readable here or every
		# page that uses Torus breaks -- including 2025 submissions re-rendered
		# for grading. Scoped to /static/vendor/ rather than /static/: the
		# editor's own CSS and JS have no business on the public host.
		@vendor {
			method GET HEAD
			path /static/vendor/*
		}
		handle @vendor {
			reverse_proxy codeframe:{$CODEFRAME_PORT} {
				header_down -Set-Cookie
			}
		}
		# /api/*, /static/* and everything else: neither an artifact nor a
		# user-facing entry point. Redirecting a write API across origins
		# would only be confusing, so these are simply gone from this host.
		handle {
			respond 404
		}
	}
}

(codeframe_editor) {
	# CSRF. The two codeframe hosts are same-SITE, so SameSite=Lax does not
	# stop a top-level cross-origin request from carrying the session cookie;
	# only an exact Origin check does. A state-changing request with no Origin
	# header is rejected too -- browsers always send one on POST.
	@cross_origin_write {
		method POST PUT PATCH DELETE
		not header Origin https://editor.{$NAKED_FQDN}
	}

	# A saved preview is an artifact and belongs on the artifact origin.
	# Codeframe builds these URLs from window.location.origin and is being
	# patched to use CODEFRAME_ARTIFACT_ORIGIN instead (issue #360); the proxy
	# moves them regardless, so authored JavaScript cannot execute on the
	# origin that holds the cookie even if that patch regresses.
	@artifact path_regexp ^/f/[^/]+/[^/]+\.html$

	route {
		# The CAS dance happens on THIS host. authapp's login handler builds
		# its CAS service URL from the request's own Host, so the session
		# cookie it sets is host-only to editor.<domain> and never widens to
		# the artifact host. Auth requests carry no large bodies.
		handle /auth/* {
			request_body {
				max_size 1MB
			}
			reverse_proxy authapp:{$AUTHAPP_PORT}
		}
		handle @artifact {
			redir https://code.{$NAKED_FQDN}{uri} 302
		}
		handle @cross_origin_write {
			respond "Cross-origin request rejected" 403
		}
		handle {
			# Nested route again for literal ordering: the body cap has to be
			# in place before anything reads the body.
			route {
				request_body {
					# codeframe's body parser accepts 50kb, so bound it here
					# too. KiB, not KB: codeframe means 50 * 1024.
					max_size 50KiB
				}
				# Nobody downstream may name themselves. copy_headers below
				# already deletes this before setting authapp's value, but only
				# on the path where the subrequest returned 2xx; deleting it up
				# front means the header reaching codeframe came from authapp
				# under every outcome, including ones a later Caddy might
				# handle differently.
				request_header -X-Yeluke-Netid

				# /auth/me answers 401 for a signed-out caller and forward_auth
				# only continues on 2xx, so without this the browser would be
				# shown that 401. handle_response, not handle_errors: a 401
				# from an upstream is an ordinary response, not a Caddy
				# handler error, so handle_errors never sees it.
				forward_auth authapp:{$AUTHAPP_PORT} {
					uri /auth/me
					# Every publish is now made by a known person, and nothing
					# recorded which (issue #366). Codeframe writes an
					# attribution record beside each frame it stores, and this
					# is the only way the netid can reach it: forward_auth can
					# copy response headers from the subrequest onto the
					# request it lets through, but it cannot read /auth/me's
					# JSON body, so authapp answers with the netid as a header
					# for exactly this.
					copy_headers X-Yeluke-Netid
					@unauthenticated status 401
					handle_response @unauthenticated {
						# The path only, never {http.request.uri}: an "&" in a
						# raw query string would become a second parameter of
						# the login URL. Codeframe's routes carry no query.
						redir * /auth/login?next={http.request.uri.path} temporary
					}
				}
				reverse_proxy codeframe:{$CODEFRAME_PORT} {
					# Caddy's per-request id, so an attribution record can be
					# matched against this proxy's own view of the request
					# while the logs for it still exist. Set, not appended, so
					# a client-supplied value is replaced rather than trusted.
					header_up X-Yeluke-Request-Id {http.request.uuid}
				}
			}
		}
	}
}

(app) {
	import security_headers
	import app_csp
	import swagger_csp
	import elmclient
	import postgrest
	import authapp
	import mcpapp
	import hydra
	route /openapi/* {
		uri strip_prefix /openapi
		file_server {
			root /usr/share/caddy/html/swagger
			index index.html
		}
	}
}

import {$CADDY_ENV:production}.caddyfile
